<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/atomic_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="0dp">

    <ViewFlipper
        android:id="@+id/atomic_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateFirstView="false"
        android:autoStart="true"
        android:clipChildren="true"
        android:flipInterval="16000"
        android:inAnimation="@anim/atomic_background_in"
        android:outAnimation="@anim/atomic_background_out">
        <ImageView android:id="@+id/atomic_background_first" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/atomic_background_second" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no" />
    </ViewFlipper>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/atomic_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/atomic_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/atomic_location"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/atomic_remaining_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textSize="10sp" />

                <Chronometer
                    android:id="@+id/atomic_remaining"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textSize="17sp" />
            </LinearLayout>
        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="12dp">

            <ImageView
                android:id="@+id/atomic_progress"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_centerVertical="true"
                android:layout_marginLeft="28dp"
                android:layout_marginRight="28dp"
                android:scaleType="fitXY" />

            <ImageView
                android:id="@+id/atomic_from_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:layout_marginLeft="24dp"
                android:src="@drawable/atomic_endpoint" />

            <ImageView
                android:id="@+id/atomic_to_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginRight="24dp"
                android:src="@drawable/atomic_endpoint" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/atomic_from"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:textSize="12sp" />

            <ViewFlipper
                android:id="@+id/atomic_ticker"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_weight="1"
                android:animateFirstView="false"
                android:autoStart="true"
                android:clipChildren="true"
                android:flipInterval="16000"
                >
                <TextView android:id="@+id/atomic_ticker_1" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:singleLine="true" android:ellipsize="end" android:textSize="11sp" android:paddingHorizontal="8dp" />
                <TextView android:id="@+id/atomic_ticker_2" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:singleLine="true" android:ellipsize="end" android:textSize="11sp" android:paddingHorizontal="8dp" />
                <TextView android:id="@+id/atomic_ticker_3" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:singleLine="true" android:ellipsize="end" android:textSize="11sp" android:paddingHorizontal="8dp" />
                <TextView android:id="@+id/atomic_ticker_4" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:singleLine="true" android:ellipsize="end" android:textSize="11sp" android:paddingHorizontal="8dp" />
                <TextView android:id="@+id/atomic_ticker_5" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:singleLine="true" android:ellipsize="end" android:textSize="11sp" android:paddingHorizontal="8dp" />
                <TextView android:id="@+id/atomic_ticker_6" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:singleLine="true" android:ellipsize="end" android:textSize="11sp" android:paddingHorizontal="8dp" />
            </ViewFlipper>

            <TextView
                android:id="@+id/atomic_to"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
