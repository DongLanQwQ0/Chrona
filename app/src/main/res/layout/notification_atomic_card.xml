<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/atomic_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="0dp">

    <ViewFlipper
        android:id="@+id/atomic_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateFirstView="true"
        android:autoStart="true"
        android:clipChildren="true"
        android:flipInterval="16000"
        android:inAnimation="@anim/atomic_background_in"
        android:outAnimation="@anim/atomic_background_out">
        <ImageView android:id="@+id/atomic_background_first" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/atomic_background_second" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no" />
    </ViewFlipper>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <LinearLayout
            android:id="@+id/atomic_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/atomic_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/atomic_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView android:id="@+id/atomic_camera_space" android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:visibility="gone" android:importantForAccessibility="no" />
            <LinearLayout android:id="@+id/atomic_top_remaining" android:layout_width="56dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:visibility="gone">
                <TextView android:id="@+id/atomic_top_remaining_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1" android:textSize="10sp" />
                <TextView android:id="@+id/atomic_top_countdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1" android:textSize="17sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginEnd="8dp"
                android:gravity="center_vertical" android:orientation="vertical">
            <TextView android:id="@+id/atomic_island_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:textSize="18sp" android:textStyle="bold" android:visibility="gone" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/atomic_location_icon" android:layout_width="16dp"
                android:layout_height="16dp" android:layout_marginEnd="5dp"
                android:scaleType="fitCenter" android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/atomic_location"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="12sp" />
            </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/atomic_bottom_remaining"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/atomic_remaining_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/atomic_remaining"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textSize="17sp" />
            </LinearLayout>
            <ImageButton android:id="@+id/atomic_complete" android:layout_width="48dp"
                android:layout_height="48dp" android:layout_marginStart="8dp"
                android:clickable="true" android:focusable="true"
                android:padding="12dp" android:scaleType="fitCenter" android:contentDescription="完成本次日程提醒"
                android:background="?android:attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="4dp">

            <ImageView
                android:id="@+id/atomic_progress"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_centerVertical="true"
                android:layout_marginLeft="28dp"
                android:layout_marginRight="28dp"
                android:scaleType="fitXY" />

            <ImageView
                android:id="@+id/atomic_from_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:layout_marginLeft="24dp"
                android:src="@drawable/atomic_endpoint" />

            <ImageView
                android:id="@+id/atomic_to_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginRight="24dp"
                android:src="@drawable/atomic_endpoint" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/atomic_from"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:textSize="12sp" />

            <ViewFlipper
                android:id="@+id/atomic_ticker"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="20dp"
                android:layout_weight="1"
                android:animateFirstView="false"
                android:autoStart="true"
                android:clipChildren="true"
                android:flipInterval="16000"
                android:inAnimation="@anim/atomic_ticker_in"
                android:outAnimation="@anim/atomic_ticker_out"
                >
                <TextView android:id="@+id/atomic_ticker_1" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:singleLine="true" android:ellipsize="end" android:textSize="11sp" android:paddingHorizontal="8dp" />
                <TextView android:id="@+id/atomic_ticker_2" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:singleLine="true" android:ellipsize="end" android:textSize="11sp" android:paddingHorizontal="8dp" />
                <TextView android:id="@+id/atomic_ticker_3" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:singleLine="true" android:ellipsize="end" android:textSize="11sp" android:paddingHorizontal="8dp" />
                <TextView android:id="@+id/atomic_ticker_4" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:singleLine="true" android:ellipsize="end" android:textSize="11sp" android:paddingHorizontal="8dp" />
                <TextView android:id="@+id/atomic_ticker_5" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:singleLine="true" android:ellipsize="end" android:textSize="11sp" android:paddingHorizontal="8dp" />
                <TextView android:id="@+id/atomic_ticker_6" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:singleLine="true" android:ellipsize="end" android:textSize="11sp" android:paddingHorizontal="8dp" />
            </ViewFlipper>

            <TextView
                android:id="@+id/atomic_to"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
