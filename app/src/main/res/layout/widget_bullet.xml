<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_bullet_frame" android:layout_width="600dp"
    android:layout_height="match_parent" android:clipChildren="true"
    android:clickable="false" android:focusable="false">
<TextView android:id="@+id/widget_bullet_text" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:gravity="center_vertical"
    android:singleLine="true" android:textSize="12sp" android:ellipsize="end"
    android:paddingHorizontal="4dp" android:importantForAccessibility="no"
    android:textDirection="ltr" android:layoutDirection="ltr" />
</FrameLayout>
