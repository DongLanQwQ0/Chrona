<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Animation.Chrona.Page" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/page_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/page_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/page_return</item>
        <item name="android:activityCloseExitAnimation">@anim/page_close</item>
    </style>
    <style name="Animation.Chrona.Dialog" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>
    <color name="chrona_startup_background">#F6F8F5</color>
    <bool name="chrona_startup_light_bars">true</bool>
    <style name="Theme.Chrona.Starting.Base" parent="Theme.Chrona.Light">
        <item name="android:windowBackground">@color/chrona_startup_background</item>
    </style>
    <style name="Theme.Chrona.Starting" parent="Theme.Chrona.Starting.Base" />
    <style name="Theme.Chrona.Light" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#F6F8F5</item>
        <item name="android:colorAccent">#006B60</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#F6F8F5</item>
        <item name="android:statusBarColor">#F6F8F5</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.Chrona.Dark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#101B1B</item>
        <item name="android:colorAccent">#80D8C9</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#101B1B</item>
        <item name="android:statusBarColor">#101B1B</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.Chrona.Blue.Light" parent="Theme.Chrona.Light">
        <item name="android:colorAccent">#315CA7</item>
    </style>
    <style name="Theme.Chrona.Blue.Dark" parent="Theme.Chrona.Dark">
        <item name="android:colorAccent">#A9C7FF</item>
    </style>
    <style name="Theme.Chrona.Coral.Light" parent="Theme.Chrona.Light">
        <item name="android:colorAccent">#9B4B32</item>
    </style>
    <style name="Theme.Chrona.Coral.Dark" parent="Theme.Chrona.Dark">
        <item name="android:colorAccent">#FFB4A1</item>
    </style>
    <style name="Theme.Chrona.Wallpaper.Light" parent="Theme.Chrona.Light" />
    <style name="Theme.Chrona.Wallpaper.Dark" parent="Theme.Chrona.Dark" />
</resources>
